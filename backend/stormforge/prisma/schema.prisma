generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  inboundEmail      String?   @unique
  imapEmail         String?
  imapPassword      String?
  imapHost          String?   @default("imap.gmail.com")
  imapPort          Int?      @default(993)
  imapEnabled       Boolean   @default(false)
  lastImapSync      DateTime?
  gmailAccessToken  String?
  gmailRefreshToken String?
  gmailTokenExpiry  DateTime?
  gmailEmail        String?
  gmailConnected    Boolean   @default(false)
  gmailLastSyncAt   DateTime?
  whatsappApiKey        String?
  whatsappPhoneNumber   String?
  whatsappWabaId        String?
  whatsappWebhookSecret String?
  whatsappConnected     Boolean  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cannedResponses CannedResponse[]
  notes           Note[]
  contacts        Contact[]
  deals           Deal[]
  callLogs        CallLog[]
  contactNotes    ContactNote[]

  users     User[]
  customers Customer[]
  tickets   Ticket[]
  tasks     Task[]
  invites   Invite[]
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String?
  googleId       String?  @unique
  role           String   @default("AGENT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String

  assignedTickets Ticket[] @relation("AgentTickets")
  assignedTasks   Task[]   @relation("AssignedTasks")
  createdTasks    Task[]   @relation("CreatedTasks")
  assignedDeals   Deal[]   @relation("AssignedDeals")
  callLogs        CallLog[]
  contactNotes    ContactNote[]
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  email          String?
  phone          String?
  company        String?
  status         String   @default("ACTIVE")
  tags           String?
  lastActivity   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  tickets Ticket[]
  notes   Note[]
  deals   Deal[]
}

model Ticket {
  id              String   @id @default(uuid())
  subject         String
  description     String
  status          String   @default("OPEN")
  priority        String   @default("MEDIUM")
  source          String   @default("MANUAL")
  emailThreadId   String?
  emailMessageId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String

  customer        Customer @relation(fields: [customerId], references: [id])
  customerId      String

  assignedAgent   User?    @relation("AgentTickets", fields: [assignedAgentId], references: [id])
  assignedAgentId String?

  messages Message[]
  tasks    Task[]
}

model Message {
  id         String   @id @default(uuid())
  body       String
  senderType String
  createdAt  DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId String
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedToId String?

  ticket   Ticket? @relation(fields: [ticketId], references: [id])
  ticketId String?

  contact   Contact? @relation(fields: [contactId], references: [id])
  contactId String?

  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String
}

model CannedResponse {
  id             String   @id @default(uuid())
  title          String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model Note {
  id             String   @id @default(uuid())
  content        String   @db.Text
  createdAt      DateTime @default(now())

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model Contact {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  company   String?
  jobTitle  String?
  source    String?
  status    String   @default("LEAD")
  notes     String?  @db.Text
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  deals        Deal[]
  tasks        Task[]
  callLogs     CallLog[]
  contactNotes ContactNote[]
}

model CallLog {
  id        String   @id @default(uuid())
  outcome   String
  duration  Int?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  agent   User?   @relation(fields: [agentId], references: [id])
  agentId String?
}

model ContactNote {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  agent   User?   @relation(fields: [agentId], references: [id])
  agentId String?
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  value             Float?
  currency          String    @default("USD")
  stage             String    @default("LEAD")
  probability       Int?
  expectedCloseDate DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String

  contact         Contact?  @relation(fields: [contactId], references: [id])
  contactId       String?

  customer        Customer? @relation(fields: [customerId], references: [id])
  customerId      String?

  assignedAgent   User?     @relation("AssignedDeals", fields: [assignedAgentId], references: [id])
  assignedAgentId String?
}

model Invite {
  id             String    @id @default(uuid())
  token          String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}